# Copy this file to .env.local and fill in values LATER.
# NEVER commit .env.local. NEVER put secrets in files under src/ui.

# "mock" = fake data, no accounts needed (default). "real" = use real keys below.
APP_MODE=mock

# Phase 1 (Supabase)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # server only, secret

# Phase 4 (AI)
# ANTHROPIC_API_KEY=           # server only, secret

# ---- Marketing OS (Agency HQ) ----
# Supabase project "marketing-os" (ref qludiulirhytdomcggfy, region ap-south-1). Set these in Vercel + .env.local, NEVER in git.
# NEXT_PUBLIC_SUPABASE_URL=https://qludiulirhytdomcggfy.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=      # Supabase -> Project Settings -> API (safe to expose)
# DATABASE_URL=                              # SECRET. Supabase -> Connect -> Transaction pooler string (contains the DB password)
# HQ_AGENCY_ID=9cc2f01a-2309-4450-89dd-d6fc9e95e3d7   # the "ScapeMedia" row in agency.agencies
# HQ_ALLOW_OPEN=                             # leave unset. 1 = open HQ without login (dev only)
# HQ_AI=off                                  # on = allow AI calls (needs ANTHROPIC_API_KEY, see docs/AI_PROVIDER_PROPOSAL.md)
# ANTHROPIC_API_KEY=                         # SECRET, server only
# HQ_AI_MAX_CALLS=20
